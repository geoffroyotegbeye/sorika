# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://sorika:sorika123@localhost:5433/sorika?schema=public"

# JWT Configuration
# Générer un secret sécurisé: openssl rand -base64 32
JWT_SECRET="votre-secret-jwt-super-securise-changez-moi-en-production"

# Application Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
FRONTEND_URL="http://localhost:3000"

# AWS S3 Configuration (pour le stockage des médias)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="votre-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="votre-aws-secret-access-key"
S3_BUCKET_NAME="sorika-uploads"

# Optional: Logging
# LOG_LEVEL=debug
